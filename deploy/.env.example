# Copy to deploy/.env (never commit it). Secrets such as database passwords live in deploy/secrets/,
# created by deploy/generate-secrets.sh.

# Public host name; DNS must point at this server. For the local demo use: localhost
ANGEL_DOMAIN=angel.example.org

# Image tag to build/run.
ANGEL_VERSION=local

# Contact shown to the operators of public sources (some APIs, e.g. SEC EDGAR, require one).
ANGEL_OPERATOR_CONTACT=osint-team@example.org

# AI assistant (Claude). Leave empty to run without the assistant.
ANGEL_ANTHROPIC_API_KEY=

# Optional keyed connectors. Empty means "not configured" (shown as "needs key").
ANGEL_BRAVE_API_KEY=
ANGEL_TINEYE_API_KEY=
ANGEL_GOOGLE_VISION_API_KEY=
ANGEL_GITHUB_TOKEN=
ANGEL_STACKEXCHANGE_KEY=

# Retention defaults can also be changed later under Administration → Retention.
# ANGEL_IMAGE_ORIGINAL_RETENTION_HOURS=24
